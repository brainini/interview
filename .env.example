# Copy to .env.local for `vercel dev`, and set the same vars in the Vercel dashboard.
# NEVER commit real values. Rotate any key that has been exposed.

# Anthropic (Claude) — server-side only. Used for the 3-link web search + feedback.
ANTHROPIC_API_KEY=sk-ant-...

# LiveAvatar (HeyGen) — server-side only. Used to mint FULL-mode session tokens.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_CONTEXT_ID=
# Required if your avatar has no default voice. Get an id from GET /v1/voices. Defaults language to en.
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_LANGUAGE=en
LIVEAVATAR_SANDBOX=false

# Optional: comma-separated allow-list of domains for evidence web search
# (leave empty to search the whole web; the model is still told to prefer kid-friendly sources).
# EVIDENCE_ALLOWED_DOMAINS=kids.nationalgeographic.com,timeforkids.com,sciencenewsforstudents.org,ducksters.com,bbc.co.uk
